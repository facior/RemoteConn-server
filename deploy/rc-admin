#!/usr/bin/env bash
# rc-admin - administration of the RemoteConn server (root only).
# Every change is recorded in /var/log/remoteconn-admin.log.

set -Eeuo pipefail

SERVICE=remoteconn-server
SERVICE_USER=remoteconn
CONF_DIR=/etc/remoteconn
ENV_FILE=$CONF_DIR/server.env
INSTALL_CONF=$CONF_DIR/install.conf
BIN=/usr/local/bin/rc-server
ADMIN_LOG=/var/log/remoteconn-admin.log
CREDENTIALS=/root/remoteconn-credentials.txt

die() { echo "BŁĄD: $*" >&2; exit 1; }

[[ $EUID -eq 0 ]] || die "rc-admin wymaga uprawnień roota (sudo rc-admin ...)"
[[ -f $ENV_FILE ]] || die "serwer nie jest zainstalowany ($ENV_FILE nie istnieje)"

env_value() { grep -oP "^$1=\K.*" "$ENV_FILE" || true; }
DATA_DIR=$(env_value RC_DATA_DIR)
DATA_DIR=${DATA_DIR:-/var/lib/remoteconn}

audit() {
    local who=${SUDO_USER:-$(logname 2>/dev/null || echo root)}
    echo "$(date -Is) $who $*" >>"$ADMIN_LOG"
}

# Data files belong to the service user: never touch them as root.
server_cmd() {
    runuser -u "$SERVICE_USER" -- env RC_DATA_DIR="$DATA_DIR" "$BIN" "$@"
}

set_env() {
    local key=$1 value=$2 tmp
    tmp=$(mktemp "$CONF_DIR/.server.env.XXXXXX")
    if grep -q "^$key=" "$ENV_FILE"; then
        awk -v k="$key" -v v="$value" 'BEGIN{FS=OFS="="} $1==k {print k "=" v; next} {print}' \
            "$ENV_FILE" >"$tmp"
    else
        cat "$ENV_FILE" >"$tmp"
        echo "$key=$value" >>"$tmp"
    fi
    chmod 0600 "$tmp"
    mv "$tmp" "$ENV_FILE"
}

usage() {
    cat <<EOF
rc-admin - administracja serwerem RemoteConn

  status                     stan usługi, port, odcisk, liczba urządzeń, zapora
  logs [-f]                  dziennik serwera (-f: na bieżąco)
  devices                    zarejestrowane urządzenia (ID, nazwa)
  blocklist                  lista blokad
  block ip <adres>           zablokuj adres IP
  block net <sieć/prefiks>   zablokuj sieć, np. 198.51.100.0/24
  block device <ID>          zablokuj urządzenie (rozłącza je od razu)
  unblock <wartość>          usuń blokadę (adres, sieć albo ID)
  key show                   pokaż klucz dostępu
  key rotate                 nowy klucz dostępu (klienci muszą go wpisać!)
  app                        dane do aplikacji: kod konfiguracji do wklejenia + adres, klucz, odcisk
  address [host[:port]]      pokaż albo ustaw publiczny adres serwera (do kodu konfiguracji)
  fingerprint                odcisk certyfikatu (porównaj z aplikacją)
  config                    bieżąca konfiguracja (klucz ukryty)
  restart                    restart usługi
  backup [katalog]           kopia danych i konfiguracji (domyślnie /root)
  audit                      dziennik działań administratora

Aktualizacje (wydania = tagi vX.Y.Z w repozytorium na GitHubie):
  update check               sprawdź, czy jest nowe wydanie (robi to też codziennie timer)
  update [vX.Y.Z]            zainstaluj wydanie (domyślnie najnowsze); przy błędzie wraca poprzednia wersja
  update status              stan ostatniej aktualizacji
  Główny administrator może też zlecić aktualizację w panelu WWW (wymaga 2FA).

Panel WWW (tylko 127.0.0.1, dostęp przez tunel SSH):
  panel setup                przewodnik: konto administratora panelu + 2FA
  panel url                  jak otworzyć panel (polecenie tunelu SSH)
  panel user list            konta panelu
  panel user add <nazwa>     nowe konto (pyta o hasło, min. 12 znaków)
  panel user passwd <nazwa>  zmiana hasła
  panel user totp <nazwa>    włącz 2FA (kod QR do aplikacji uwierzytelniającej)
  panel user totp-off <nazwa> wyłącz 2FA
  panel user remove <nazwa>  usuń konto (jego sesje kończą się od razu)
  panel audit                logowania i zmiany wykonane w panelu
  panel off | panel on       wyłącz / włącz panel (restart usługi)

Konta użytkowników (łączenie bez hasła między własnymi komputerami):
  account list               konta i ich urządzenia
  account invite [opis]      kod zaproszenia (jednorazowy, 7 dni)
  account disable <nazwa>    zablokuj konto (z panelu działa od razu na hostach)
  account enable <nazwa>     odblokuj
  account delete <nazwa>     usuń konto
  accounts mode invite|open|off  kto może zakładać konta (restart usługi)

Blokady działają bez restartu (serwer sprawdza listę co kilka sekund).
EOF
}

# ------------------------------------------------------------------ updates
# Releases are tags vX.Y.Z in the repository. The check (daily timer) and the
# installation (started by the panel's request file or by hand) run as root;
# the server only reads the state files written here.

UPDATE_AVAILABLE=update-available.json
UPDATE_STATUS=update-status.json
UPDATE_REQUEST=update-request.json
UPDATE_LOG=/var/log/remoteconn-update.log
VERSION_RE='^v[0-9]+\.[0-9]+\.[0-9]+$'

repo_dir() {
    local repo
    repo=$(grep -oP '^REPO_DIR=\K.*' "$INSTALL_CONF" 2>/dev/null || true)
    [[ -n $repo && -f $repo/deploy/install.sh ]] \
        || die "nie znaleziono repozytorium (REPO_DIR w $INSTALL_CONF)"
    echo "$repo"
}

# git as root in a repository that may belong to another user.
repo_git() {
    local repo=$1
    shift
    git -c safe.directory="$repo" -C "$repo" "$@"
}

json_str() {
    local s
    s=$(printf '%s' "$1" | tr -d '\000-\010\013\014\016-\037')
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\t'/\\t}
    s=${s//$'\r'/}
    s=${s//$'\n'/\\n}
    printf '"%s"' "$s"
}

# Writes a state file the (unprivileged) server can read.
write_state() {
    local name=$1 content=$2 tmp
    tmp=$(mktemp "$DATA_DIR/.$name.XXXXXX")
    printf '%s\n' "$content" >"$tmp"
    chown "$SERVICE_USER:$SERVICE_USER" "$tmp"
    chmod 0600 "$tmp"
    mv "$tmp" "$DATA_DIR/$name"
}

set_update_status() {
    local state=$1 version=$2 by=$3 message=$4 log=${5:-}
    write_state "$UPDATE_STATUS" "{\"state\":$(json_str "$state"),\"version\":$(json_str "$version"),\"requested_by\":$(json_str "$by"),\"updated_unix\":$(date +%s),\"message\":$(json_str "$message"),\"log\":$(json_str "$log")}"
}

installed_version() {
    server_cmd version 2>/dev/null || echo 0.0.0
}

# True when $1 (vX.Y.Z) is newer than $2 (X.Y.Z).
version_newer() {
    local a=${1#v} b=${2#v}
    [[ $a != "$b" && $(printf '%s\n%s\n' "$a" "$b" | sort -V | tail -n1) == "$a" ]]
}

latest_tag() {
    repo_git "$1" tag -l 'v[0-9]*.[0-9]*.[0-9]*' --sort=-v:refname | grep -E "$VERSION_RE" | head -n1
}

update_check() {
    local repo latest notes error="" current
    repo=$(repo_dir)
    current=$(installed_version)
    if ! error=$(repo_git "$repo" fetch --tags --force --quiet origin 2>&1); then
        write_state "$UPDATE_AVAILABLE" "{\"latest\":\"\",\"checked_unix\":$(date +%s),\"notes\":\"\",\"error\":$(json_str "nie można pobrać wydań z repozytorium: ${error:0:300}")}"
        echo "Nie można sprawdzić wydań: $error" >&2
        return 1
    fi
    latest=$(latest_tag "$repo")
    notes=""
    [[ -n $latest ]] && notes=$(repo_git "$repo" tag -l --format='%(contents)' "$latest" | head -c 4000)
    write_state "$UPDATE_AVAILABLE" "{\"latest\":$(json_str "$latest"),\"checked_unix\":$(date +%s),\"notes\":$(json_str "$notes"),\"error\":\"\"}"
    if [[ -n $latest ]] && version_newer "$latest" "$current"; then
        echo "Dostępne wydanie $latest (zainstalowana wersja $current)."
    else
        echo "Masz najnowszą wersję ($current)."
    fi
}

# Installs release $1, requested by $2. Rolls back if the new version does
# not start.
update_apply() {
    local version=$1 by=$2 repo current prev_ref
    exec 9>/run/remoteconn-update.lock
    flock -n 9 || die "aktualizacja już trwa"
    repo=$(repo_dir)
    current=$(installed_version)
    [[ $version =~ $VERSION_RE ]] || die "nieprawidłowa wersja: $version"
    repo_git "$repo" fetch --tags --force --quiet origin || true
    if ! repo_git "$repo" rev-parse -q --verify "refs/tags/$version" >/dev/null; then
        set_update_status failed "$version" "$by" "nie ma takiego wydania w repozytorium"
        die "nie ma wydania $version"
    fi
    if ! version_newer "$version" "$current"; then
        set_update_status failed "$version" "$by" "to nie jest nowsza wersja niż zainstalowana ($current)"
        die "$version nie jest nowsza niż $current"
    fi
    audit "update $current -> $version (zlecił: $by)"
    set_update_status running "$version" "$by" "budowanie nowej wersji"
    prev_ref=$(repo_git "$repo" rev-parse HEAD)
    cp -p "$BIN" "$BIN.prev"
    if ! repo_git "$repo" checkout --quiet --detach "$version" 2>"$UPDATE_LOG"; then
        set_update_status failed "$version" "$by" "nie można przełączyć repozytorium (lokalne zmiany?)" "$(tail -n 20 "$UPDATE_LOG")"
        die "git checkout $version nie powiódł się (szczegóły: $UPDATE_LOG)"
    fi
    if bash "$repo/deploy/install.sh" --update >>"$UPDATE_LOG" 2>&1 \
        && sleep 3 && systemctl is-active --quiet "$SERVICE" \
        && [[ $(installed_version) == "${version#v}" ]]; then
        set_update_status "done" "$version" "$by" "zainstalowano $version (poprzednio $current)"
        audit "update done: $version"
        echo "Zaktualizowano do $version."
        update_check >/dev/null || true
        return 0
    fi
    # Roll back: previous binary and sources.
    cp -p "$BIN.prev" "$BIN"
    repo_git "$repo" checkout --quiet --detach "$prev_ref" || true
    systemctl restart "$SERVICE" || true
    set_update_status failed "$version" "$by" "nowa wersja nie wystartowała; przywrócono $current" "$(tail -n 30 "$UPDATE_LOG")"
    audit "update failed: $version, rolled back to $current"
    die "aktualizacja do $version nie powiodła się, przywrócono $current (szczegóły: $UPDATE_LOG)"
}

# Run by remoteconn-update.service when the panel leaves a request.
update_from_request() {
    local file=$DATA_DIR/$UPDATE_REQUEST content version by
    [[ -f $file ]] || return 0
    content=$(head -c 4096 "$file")
    # Removed first: the path unit would start again while it exists.
    rm -f "$file"
    version=$(grep -oP '"version"\s*:\s*"\K[^"]+' <<<"$content" | head -n1 || true)
    by=$(grep -oP '"requested_by"\s*:\s*"\K[A-Za-z0-9._-]{1,32}(?=")' <<<"$content" | head -n1 || true)
    [[ -n $by ]] || by=panel
    if [[ ! $version =~ $VERSION_RE ]]; then
        set_update_status failed "${version:0:20}" "$by" "nieprawidłowa prośba o aktualizację"
        die "nieprawidłowa prośba o aktualizację"
    fi
    update_apply "$version" "$by"
}

# Guided setup: administrator account, then two-factor authentication.
panel_setup() {
    local name answer existing line
    if [[ $(env_value RC_ADMIN_BIND) =~ ^(off|none)$ ]]; then
        die "panel jest wyłączony (włącz: sudo rc-admin panel on)"
    fi
    [[ -t 0 ]] || die "konfiguracja panelu pyta o hasło: uruchom ją w terminalu"
    echo "Konfiguracja panelu WWW: konto administratora i weryfikacja dwuetapowa (2FA)."
    echo
    existing=$(server_cmd panel-user list 2>/dev/null || true)
    if [[ -n $existing ]]; then
        echo "Istniejące konta:"
        while IFS= read -r line; do echo "  $line"; done <<<"$existing"
        echo
    fi
    while true; do
        read -r -p "Nazwa użytkownika panelu [admin]: " name
        name=${name:-admin}
        [[ $name =~ ^[A-Za-z0-9._-]{1,32}$ ]] && break
        echo "  Dozwolone są litery, cyfry oraz . _ - (do 32 znaków)."
    done
    if grep -q "^$name  " <<<"$existing"; then
        echo "Konto $name już istnieje; pomijam zakładanie."
    else
        server_cmd panel-user add "$name" || die "nie utworzono konta $name"
        audit "panel user add $name"
    fi
    echo
    if grep -q "^$name  2FA on" <<<"$(server_cmd panel-user list 2>/dev/null)"; then
        echo "2FA jest już włączone dla $name."
    else
        echo "Teraz 2FA: po haśle panel będzie pytał o kod z aplikacji na telefonie."
        echo "Przygotuj aplikację uwierzytelniającą (Google/Microsoft Authenticator, Aegis, 1Password…)."
        read -r -p "Włączyć 2FA teraz (zalecane)? [T/n] " answer
        if [[ $answer =~ ^[nN]$ ]]; then
            echo "  Pominięto. Włączysz później: sudo rc-admin panel user totp $name"
        elif server_cmd panel-user totp "$name"; then
            audit "panel user totp $name"
        else
            echo "  2FA nie zostało włączone. Spróbuj ponownie: sudo rc-admin panel user totp $name"
        fi
    fi
    echo
    panel_url
}

panel_url() {
    local bind port host
    bind=$(env_value RC_ADMIN_BIND)
    if [[ $bind == off || $bind == none ]]; then
        echo "Panel jest wyłączony (włącz: sudo rc-admin panel on)."
        return
    fi
    port=${bind##*:}
    port=${port:-8080}
    host=$(curl -fsS --max-time 5 https://api.ipify.org 2>/dev/null || hostname -I | awk '{print $1}')
    cat <<EOF
Panel nasłuchuje tylko na 127.0.0.1:$port - z internetu nie jest dostępny.

Na swoim komputerze (Windows: PowerShell, macOS/Linux: terminal):

    ssh -N -L $port:127.0.0.1:$port ${SUDO_USER:-root}@${host:-<adres-serwera>}

i otwórz w przeglądarce:  http://localhost:$port
(tunel działa, dopóki to okno jest otwarte; zamknij je, gdy skończysz)

Konta: sudo rc-admin panel user list
EOF
}

cmd=${1:-help}
shift || true

case $cmd in
    status)
        systemctl --no-pager --lines=0 status "$SERVICE" || true
        echo
        echo "Port:          $(env_value RC_BIND)"
        echo "Odcisk:        $(server_cmd fingerprint | head -n1)"
        echo "Urządzenia:    $(server_cmd devices 2>/dev/null | wc -l)"
        echo "Blokady:       $(server_cmd blocklist 2>/dev/null | wc -l)"
        echo "Konta:         $(server_cmd account list 2>/dev/null | grep -cv '^    ' || true) (zakładanie: $(env_value RC_ACCOUNTS | sed 's/^$/invite/'))"
        panel=$(env_value RC_ADMIN_BIND)
        if [[ $panel == off || $panel == none ]]; then
            echo "Panel WWW:     wyłączony"
        else
            echo "Panel WWW:     ${panel:-127.0.0.1:8080}, kont: $(server_cmd panel-user list 2>/dev/null | wc -l) (rc-admin panel url)"
        fi
        if [[ -n $(env_value RC_ACCESS_KEY) ]]; then
            echo "Klucz dostępu: ustawiony"
        else
            echo "Klucz dostępu: BRAK - serwer otwarty dla wszystkich (rc-admin key rotate)"
        fi
        if command -v ufw >/dev/null; then
            echo "Zapora:        $(ufw status | head -n1)"
        elif command -v firewall-cmd >/dev/null; then
            echo "Zapora:        firewalld $(firewall-cmd --state 2>/dev/null || echo nieaktywny)"
        fi
        ;;
    logs)
        if [[ ${1:-} == -f ]]; then
            journalctl -u "$SERVICE" -f
        else
            journalctl -u "$SERVICE" -n 200 --no-pager
        fi
        ;;
    devices)
        server_cmd devices
        ;;
    blocklist)
        server_cmd blocklist
        ;;
    block)
        [[ $# -ge 2 ]] || die "użycie: rc-admin block <ip|net|device> <wartość>"
        kind=$1
        shift
        server_cmd block "$kind" "$*"
        audit "block $kind $*"
        ;;
    unblock)
        [[ $# -ge 1 ]] || die "użycie: rc-admin unblock <wartość>"
        server_cmd unblock "$*"
        audit "unblock $*"
        ;;
    key)
        case ${1:-} in
            show)
                env_value RC_ACCESS_KEY
                audit "key show"
                ;;
            rotate)
                if [[ ${2:-} != --yes ]]; then
                    read -r -p "Nowy klucz rozłączy klientów do czasu wpisania go w aplikacji. Kontynuować? [t/N] " a
                    [[ $a =~ ^[tTyY]$ ]] || die "anulowano"
                fi
                new_key=$("$BIN" gen-key)
                set_env RC_ACCESS_KEY "$new_key"
                systemctl restart "$SERVICE"
                if [[ -f $CREDENTIALS ]]; then
                    sed -i -e "s|^Klucz dostępu:.*|Klucz dostępu:      $new_key|" \
                        -e "s|^Kod konfiguracji:.*|Kod konfiguracji:   (nowy: sudo rc-admin app)|" "$CREDENTIALS"
                fi
                audit "key rotate"
                echo "Nowy klucz dostępu: $new_key"
                echo "Nowy kod konfiguracji dla aplikacji: sudo rc-admin app"
                ;;
            *) die "użycie: rc-admin key show|rotate" ;;
        esac
        ;;
    app | client)
        addr=$(env_value RC_PUBLIC_ADDR)
        [[ -n $addr ]] || die "nie ustawiono publicznego adresu serwera: rc-admin address <adres-lub-domena>"
        key=$(env_value RC_ACCESS_KEY)
        # Through the environment, not arguments: the key stays out of ps.
        code=$(RC_PUBLIC_ADDR=$addr RC_ACCESS_KEY=$key server_cmd config-code)
        audit "app (kod konfiguracji)"
        cat <<EOF
Kod konfiguracji (aplikacja: Ustawienia -> Sieć -> "Wklej kod"):

$code

Albo ręcznie:
  Serwer ID:      $addr
  Klucz dostępu:  ${key:-brak (serwer otwarty)}
  Odcisk:         $(server_cmd fingerprint | head -n1)

Kod zawiera klucz dostępu: przekazuj go tylko swoim użytkownikom.
EOF
        ;;
    address)
        if [[ $# -eq 0 ]]; then
            addr=$(env_value RC_PUBLIC_ADDR)
            echo "${addr:-nie ustawiono (rc-admin address <adres-lub-domena>)}"
            exit 0
        fi
        addr=$1
        [[ $addr =~ ^[A-Za-z0-9.:-]+$|^\[[0-9A-Fa-f:]+\](:[0-9]+)?$ ]] || die "nieprawidłowy adres: $addr"
        # No port given (a bare name, IPv4 or [IPv6]): use the server's port.
        if [[ $addr != *:* || $addr == *"]" ]]; then
            port=$(env_value RC_BIND)
            addr="$addr:${port##*:}"
        fi
        set_env RC_PUBLIC_ADDR "$addr"
        systemctl restart "$SERVICE"
        audit "address $addr"
        echo "Publiczny adres serwera: $addr (kod konfiguracji: rc-admin app)"
        ;;
    fingerprint)
        server_cmd fingerprint
        ;;
    config)
        sed -E 's/^(RC_ACCESS_KEY=).+/\1******** (rc-admin key show)/' "$ENV_FILE"
        ;;
    restart)
        systemctl restart "$SERVICE"
        audit "restart"
        systemctl --no-pager --lines=5 status "$SERVICE" || true
        ;;
    backup)
        dest=${1:-/root}
        file=$dest/remoteconn-backup-$(date +%Y%m%d-%H%M%S).tar.gz
        umask 077
        tar -czf "$file" -C / "${DATA_DIR#/}" "${CONF_DIR#/}"
        audit "backup $file"
        echo "Kopia (tylko root): $file"
        echo "Zawiera klucz prywatny serwera i klucz dostępu - przechowuj ją bezpiecznie."
        ;;
    audit)
        tail -n 100 "$ADMIN_LOG"
        ;;
    panel)
        case ${1:-} in
            setup)
                panel_setup
                ;;
            url)
                panel_url
                ;;
            user)
                sub=${2:-}
                name=${3:-}
                case $sub in
                    list)
                        server_cmd panel-user list
                        ;;
                    add|passwd|totp|totp-off|remove)
                        [[ -n $name ]] || die "użycie: rc-admin panel user $sub <nazwa>"
                        server_cmd panel-user "$sub" "$name"
                        audit "panel user $sub $name"
                        ;;
                    *) die "użycie: rc-admin panel user list|add|passwd|totp|totp-off|remove <nazwa>" ;;
                esac
                ;;
            audit)
                if [[ -f $DATA_DIR/panel-audit.log ]]; then
                    tail -n 100 "$DATA_DIR/panel-audit.log"
                else
                    echo "Brak wpisów."
                fi
                ;;
            off)
                set_env RC_ADMIN_BIND off
                systemctl restart "$SERVICE"
                audit "panel off"
                echo "Panel wyłączony."
                ;;
            on)
                port=${2:-8080}
                [[ $port =~ ^[0-9]+$ ]] || die "użycie: rc-admin panel on [port]"
                set_env RC_ADMIN_BIND "127.0.0.1:$port"
                systemctl restart "$SERVICE"
                audit "panel on $port"
                panel_url
                ;;
            *) die "użycie: rc-admin panel url|user|audit|on|off (rc-admin help)" ;;
        esac
        ;;
    account)
        sub=${1:-}
        case $sub in
            list)
                server_cmd account list
                ;;
            invite)
                shift
                server_cmd account invite "$@"
                audit "account invite $*"
                ;;
            disable|enable|delete)
                [[ -n ${2:-} ]] || die "użycie: rc-admin account $sub <nazwa>"
                server_cmd account "$sub" "$2"
                audit "account $sub $2"
                ;;
            *) die "użycie: rc-admin account list|invite|disable|enable|delete" ;;
        esac
        ;;
    accounts)
        [[ ${1:-} == mode && ${2:-} =~ ^(invite|open|off)$ ]] \
            || die "użycie: rc-admin accounts mode invite|open|off"
        set_env RC_ACCOUNTS "$2"
        systemctl restart "$SERVICE"
        audit "accounts mode $2"
        echo "Zakładanie kont: $2"
        ;;
    update)
        case ${1:-} in
            check)
                update_check
                ;;
            status)
                if [[ -f $DATA_DIR/$UPDATE_STATUS ]]; then
                    cat "$DATA_DIR/$UPDATE_STATUS"
                else
                    echo "Nie było jeszcze aktualizacji."
                fi
                echo "Zainstalowana wersja: $(installed_version)"
                ;;
            from-request)
                # Started by remoteconn-update.service (panel request).
                update_from_request
                ;;
            source)
                # Rebuild whatever is checked out (development, no release).
                repo=$(repo_dir)
                audit "update source"
                # Through bash: archives made on Windows do not keep the executable bit.
                bash "$repo/deploy/install.sh" --update
                ;;
            "")
                repo=$(repo_dir)
                repo_git "$repo" fetch --tags --force --quiet origin
                latest=$(latest_tag "$repo")
                [[ -n $latest ]] || die "repozytorium nie ma jeszcze wydań (tagów vX.Y.Z); bieżący kod: rc-admin update source"
                update_apply "$latest" "${SUDO_USER:-root}"
                ;;
            v*)
                update_apply "$1" "${SUDO_USER:-root}"
                ;;
            *) die "użycie: rc-admin update [check|status|vX.Y.Z|source]" ;;
        esac
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        usage
